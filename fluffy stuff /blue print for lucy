// KTE Formula Implementation

const calculateKTE = (rep: number, ffc: number, edi: number, ediMax: number, eTotal: number, ePlanet: number): number => {

  // KTE = (REP / (REP + FFC)) × (1 - EDI/EDI_max) × (E_total / E_planet)

  const energyRatio = rep / (rep + ffc);

  const damageFactor = 1 - (edi / ediMax);

  const planetaryRatio = eTotal / ePlanet;

  return energyRatio * damageFactor * planetaryRatio;

};

// Grn Formula Implementation

const calculateGrn = (nodes: number, efficiency: number, latencyMs: number): number => {

  // Grn = Σ(nodes × efficiency) / latency

  return (nodes * efficiency) / (latencyMs / 1000);

};

