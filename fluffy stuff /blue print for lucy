interface SystemMessage {

  id: string;                    // Unique message ID

  source: string;                // Source node (e.g., "LL001_NEON_VORTEX")

  target: string | 'BROADCAST';  // Target node or broadcast

  type: 'request' | 'response' | 'event' | 'pulse';

  payload: Record<string, any>;  // Message content

  confidence?: number;           // 0.0 - 1.0 confidence score

  trace: string[];               // Execution trace path

  timestamp: number;             // Unix timestamp

  pulseCycle?: number;           // Current pulse cycle number

  trustLevel?: TrustLevel;       // Trust calibration level

}

type TrustLevel = 'INITIATE' | 'COPILOT' | 'PARTNER' | 'SOVEREIGN';

class EventBus {

  private listeners: Record<string, EventHandler[]> = {};

  private globalListeners: EventHandler[] = [];

  private pulseCycle: number = 0;

  // Subscribe to specific message type

  subscribe(type: string, handler: EventHandler): void;

  // Subscribe to all messages (for logging/monitoring)

  subscribeAll(handler: EventHandler): void;

  // Publish message to Freeway

  publish(msg: SystemMessage): void;

  // Increment pulse cycle

  incrementPulse(): number;

  // Get current pulse cycle

  getPulseCycle(): number;

}

export const globalEventBus = new EventBus();

